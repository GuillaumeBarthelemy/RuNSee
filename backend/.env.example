DATABASE_URL="file:./dev.db"

NODE_ENV="development"

# Backend local listener
APP_HOST="0.0.0.0"
APP_PORT="3000"

# Frontend local dev server
FRONTEND_PORT="5173"
LOCAL_APP_URL="http://localhost:5173"
LOCAL_API_URL="http://localhost:3000"

# Public URLs used when the app is exposed behind Cloudflare Tunnel
# Local-only usage: you can keep localhost values.
PUBLIC_APP_URL="http://localhost:5173"
PUBLIC_API_URL="http://localhost:3000"

# Backward-compatible aliases still supported by the backend config
APP_PUBLIC_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:5173"

# Comma-separated list. Include both local and public frontend origins when using a tunnel.
FRONTEND_ALLOWED_ORIGINS="http://localhost:5173"

# Strava OAuth
# Behind Cloudflare Tunnel, this should point to:
# https://api.<your-domain>/auth/strava/callback
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
STRAVA_REDIRECT_URI="http://localhost:3000/auth/strava/callback"
RUNSEE_STRAVA_APP_ENCRYPTION_KEY=""
RUNSEE_STRAVA_TOKEN_ENCRYPTION_KEY=""
# Generic external-provider session encryption. Prefer a dedicated value in prod.
RUNSEE_PROVIDER_TOKEN_ENCRYPTION_KEY=""
STRAVA_APPROVAL_PROMPT="force"
STRAVA_SCOPE="read,profile:read_all,activity:read_all"
RUNSEE_AI_ASSISTANT_ENCRYPTION_KEY=""
OPENAI_RESPONSES_BASE_URL="https://api.openai.com/v1"
OPENAI_DEFAULT_MODEL="gpt-4.1-mini"
AUTO_INCREMENTAL_SYNC_ENABLED="true"
AUTO_INCREMENTAL_SYNC_INTERVAL_MINUTES="60"
AUTO_INCREMENTAL_SYNC_STARTUP_DELAY_SECONDS="60"

# Sync behavior
STRAVA_INCREMENTAL_FETCH_DETAILS="true"
SYNC_AFTER_OVERLAP_SECONDS="3600"
