DATABASE_URL="file:./dev.db"

NODE_ENV="development"

# Backend local listener
APP_HOST="0.0.0.0"
APP_PORT="3000"

# Frontend local dev server
FRONTEND_PORT="5173"
LOCAL_APP_URL="http://localhost:5173"
LOCAL_API_URL="http://localhost:3000"

# Public URLs used when the app is exposed behind Cloudflare Tunnel
# Local-only usage: you can keep localhost values.
PUBLIC_APP_URL="http://localhost:5173"
PUBLIC_API_URL="http://localhost:3000"

# Backward-compatible aliases still supported by the backend config
APP_PUBLIC_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:5173"

# Comma-separated list. Include both local and public frontend origins when using a tunnel.
FRONTEND_ALLOWED_ORIGINS="http://localhost:5173"

# Strava OAuth
# Behind Cloudflare Tunnel, this should point to:
# https://api.runsee.<your-domain>/auth/strava/callback
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
STRAVA_REDIRECT_URI="http://localhost:3000/auth/strava/callback"
STRAVA_SCOPE="read,profile:read_all,activity:read_all"

# Sync behavior
STRAVA_INCREMENTAL_FETCH_DETAILS="true"
SYNC_AFTER_OVERLAP_SECONDS="3600"
