DATABASE_URL="postgresql://runsee_app:change_me@127.0.0.1:55432/runsee_prod?schema=public"
DIRECT_URL="postgresql://runsee_admin:change_me@127.0.0.1:55432/runsee_prod?schema=public"
SHADOW_DATABASE_URL="postgresql://runsee_admin:change_me@127.0.0.1:55432/runsee_shadow?schema=public"

NODE_ENV="production"

# Green stack local ports during cutover rehearsal
APP_HOST="127.0.0.1"
APP_PORT="3001"

FRONTEND_PORT="5174"
LOCAL_APP_URL="http://localhost:5174"
LOCAL_API_URL="http://localhost:3001"

# Public URLs remain the production URLs
PUBLIC_APP_URL="https://runsee.<your-domain>"
PUBLIC_API_URL="https://api.<your-domain>"

APP_PUBLIC_URL="https://api.<your-domain>"
FRONTEND_URL="https://runsee.<your-domain>"
FRONTEND_ALLOWED_ORIGINS="http://localhost:5174,https://runsee.<your-domain>"

# Prefer a dedicated production Strava app
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
STRAVA_REDIRECT_URI="https://api.<your-domain>/auth/strava/callback"
STRAVA_SCOPE="read,profile:read_all,activity:read_all"

STRAVA_INCREMENTAL_FETCH_DETAILS="true"
SYNC_AFTER_OVERLAP_SECONDS="3600"
