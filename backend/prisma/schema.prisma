generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model AppUser {
  id              String             @id @default(cuid())
  email           String?
  emailNormalized String?            @unique
  passwordHash    String?
  displayName     String
  role            String             @default("user")
  status          String             @default("active")
  lastLoginAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  aiAssistantConfig UserAiAssistantConfig?
  connections StravaConnection[]
  stravaApp   UserStravaApp?
  syncJobs    SyncJob[]
  syncCursors SyncCursor[]
  sessions    UserSession[]
  trainingAnalyticsSettings UserTrainingAnalyticsSettings[]
  raceObjectives UserRaceObjective[]
  externalProviderConnections ExternalProviderConnection[]
  providerRawData ExternalProviderRawData[]
  recoverySnapshots ExternalDailyRecoverySnapshot[]
  fitnessSnapshots ExternalDailyFitnessSnapshot[]
  vdotHistory VdotHistorySnapshot[]
  activityProviderEnrichments ActivityProviderEnrichment[]
  activities Activity[]
  activityProviderLinks ActivityProviderLink[]
  providerBackfillCursors ProviderBackfillCursor[]
  providerBackfillWindowLogs ProviderBackfillWindowLog[]
}

// Course objectif planifiee par l'utilisateur, utilisee pour le countdown
// et le plan de taper recommande dans le Dashboard / Analyses.
// On garde une seule course active a la fois (isActive = true) tout en
// historisant les anciennes pour permettre le suivi a posteriori.
model UserRaceObjective {
  id                String    @id @default(cuid())
  appUserId         String
  appUser           AppUser   @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  name              String
  raceDate          DateTime
  distanceMeters    Int
  // Allure cible saisie par l'utilisateur en s/km, optionnelle.
  targetPaceSecondsPerKm Int?
  elevationGainMeters Int?
  elevationLossMeters Int?
  terrainType       String?
  targetDurationSeconds Int?
  longestClimbMeters Int?
  longestDescentMeters Int?
  priority          String?
  notes             String?
  isActive          Boolean   @default(true)
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([appUserId, isActive])
  @@index([appUserId, raceDate])
}

model UserTrainingAnalyticsSettings {
  id                           String   @id @default(cuid())
  appUserId                    String
  appUser                      AppUser  @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  effectiveFrom                DateTime @default(now())
  archivedAt                   DateTime?
  isActive                     Boolean  @default(true)
  heartRateMax                 Int?
  restingHeartrate             Int?
  biologicalSex                String?
  heartRateZone1Max            Int?
  heartRateZone2Max            Int?
  heartRateZone3Max            Int?
  heartRateZone4Max            Int?
  intensitySourcePriority      String   @default("heart_rate")
  efficiencyMinDurationMinutes Int      @default(20)
  efficiencyMaxElevationPerKm  Int      @default(25)
  efficiencyExcludeTrail       Boolean  @default(true)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  @@index([appUserId, isActive])
  @@index([appUserId, archivedAt])
  @@index([appUserId, effectiveFrom])
}

model UserAiAssistantConfig {
  id              String   @id @default(cuid())
  appUserId       String   @unique
  appUser         AppUser  @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  provider        String   @default("openai")
  model           String   @default("gpt-4.1-mini")
  apiKeyEncrypted String
  systemPrompt    String?
  enabled         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model UserSession {
  id         String   @id @default(cuid())
  appUserId  String
  appUser    AppUser  @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([appUserId, expiresAt])
}

model StravaConnection {
  id                   String    @id @default(cuid())
  appUserId            String
  appUser              AppUser   @relation(fields: [appUserId], references: [id])
  userStravaAppId      String?
  userStravaApp        UserStravaApp? @relation(fields: [userStravaAppId], references: [id], onDelete: SetNull)

  stravaAthleteId      String?   @unique
  accessToken          String?
  refreshToken         String?
  accessTokenExpiresAt DateTime?
  grantedScopes        String?
  connectedAt          DateTime  @default(now())
  lastTokenRefreshAt   DateTime?
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  athlete              Athlete?
}

model UserStravaApp {
  id                    String             @id @default(cuid())
  appUserId             String             @unique
  appUser               AppUser            @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  clientId              String
  clientSecretEncrypted String
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  connections           StravaConnection[]
}

model Athlete {
  id               String           @id @default(cuid())
  connectionId     String           @unique
  connection       StravaConnection @relation(fields: [connectionId], references: [id])

  stravaAthleteId  String           @unique
  username         String?
  firstname        String?
  lastname         String?
  city             String?
  state            String?
  country          String?
  sex              String?
  profileMediumUrl String?
  profileUrl       String?
  rawJson          String?
  lastFetchedAt    DateTime?

  activities       Activity[]

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model Activity {
  id                    String    @id @default(cuid())
  appUserId             String?
  appUser               AppUser?  @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  athleteId             String?
  athlete               Athlete?  @relation(fields: [athleteId], references: [id])

  stravaActivityId      String?   @unique
  sourceProvider        String    @default("strava")
  sourceActivityId      String    @default("")
  sourcePriority        String    @default("primary")
  sourceCreatedAt       DateTime?
  sourceUpdatedAt       DateTime?
  sourceSyncedAt        DateTime?
  sourceUrl             String?
  hasExternalEnrichment Boolean   @default(false)
  isMerged              Boolean   @default(false)
  mergedIntoActivityId  String?
  mergedAt              DateTime?
  resourceState         Int?
  externalId            String?
  uploadId              String?

  name                  String?
  description           String?

  type                  String?
  sportType             String?
  workoutType           Int?

  startDate             DateTime?
  startDateLocal        DateTime?
  timezone              String?
  utcOffset             Float?

  distance              Float?
  movingTime            Int?
  elapsedTime           Int?
  totalElevationGain    Float?
  totalElevationLoss    Float?

  startLatlngJson       String?
  endLatlngJson         String?

  achievementCount      Int?
  kudosCount            Int?
  commentCount          Int?
  athleteCount          Int?
  photoCount            Int?
  prCount               Int?
  totalPhotoCount       Int?

  trainer               Boolean?
  commute               Boolean?
  manual                Boolean?
  private               Boolean?
  flagged               Boolean?

  averageSpeed          Float?
  maxSpeed              Float?
  averageCadence        Float?
  averageWatts          Float?
  weightedAverageWatts  Int?
  kilojoules            Float?

  deviceWatts           Boolean?
  hasHeartrate          Boolean?
  averageHeartrate      Float?
  maxHeartrate          Float?
  averageTemp           Int?
  sufferScore           Int?
  calories              Float?

  mapId                 String?
  mapSummaryPolyline    String?
  mapPolyline           String?

  gearId                String?

  isDetailed            Boolean   @default(false)
  summaryJson           String?
  rawJson               String?
  summaryFetchedAt      DateTime?
  detailsFetchedAt      DateTime?
  lastFetchedAt         DateTime?

  // Effort percu par l'utilisateur sur l'echelle de Borg modifiee 1-10.
  // Permet le calcul du sRPE Foster = duree (min) * userRpe.
  userRpe               Int?
  userRpeUpdatedAt      DateTime?

  // Derive cardiaque (Pa:Hr decoupling, Allen & Coggan 2010) precalculee
  // a partir des splits Strava au moment du fetch detaille de l'activite.
  // Permet l'agregation sur la Vue d'ensemble Analyse sans recharger les
  // splits cote frontend (trop lourd pour une liste de 50+ activites).
  cardiacDecouplingPercent     Float?
  cardiacDecouplingComputedAt  DateTime?

  providerEnrichments   ActivityProviderEnrichment[]
  providerLinks         ActivityProviderLink[]

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([appUserId, sourceProvider, sourceActivityId])
  @@index([appUserId, startDate])
  @@index([athleteId, startDate])
  @@index([sourceProvider, startDate])
  @@index([appUserId, isMerged])
  @@index([mergedIntoActivityId])
}

model ExternalProviderConnection {
  id                    String    @id @default(cuid())
  appUserId             String
  appUser               AppUser   @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  providerCode          String
  status                String    @default("disconnected")
  displayName           String?
  accountIdentifier     String?
  encryptedSession      String?
  sessionSchemaVersion  String    @default("v1")
  consentAcceptedAt     DateTime?
  connectedAt           DateTime?
  disconnectedAt        DateTime?
  lastSyncAt            DateTime?
  lastBackfillStartedAt DateTime?
  lastBackfillEndedAt   DateTime?
  lastErrorCode         String?
  lastErrorMessage      String?
  lastErrorAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([appUserId, providerCode])
  @@index([providerCode, status])
  @@index([appUserId, status])
  @@index([lastSyncAt])
}

model ExternalProviderRawData {
  id                 String   @id @default(cuid())
  appUserId          String
  appUser            AppUser  @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  providerCode       String
  dataType           String
  providerDateKey    String   @default("")
  providerResourceId String   @default("")
  payloadJson        String
  payloadHash        String?
  status             String   @default("success")
  syncedAt           DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([appUserId, providerCode, dataType, providerDateKey, providerResourceId])
  @@index([appUserId, providerCode, dataType])
  @@index([providerCode, dataType, providerDateKey])
  @@index([syncedAt])
}

model ExternalDailyRecoverySnapshot {
  id                      String   @id @default(cuid())
  appUserId               String
  appUser                 AppUser  @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  sourceProvider          String
  snapshotDate            DateTime
  timezone                String?
  sleepDurationSeconds    Int?
  sleepScore              Float?
  hrvAvgMs                Float?
  hrvStatus               String?
  restingHr               Int?
  stressAvg               Float?
  stressMax               Float?
  bodyBatteryMorning      Int?
  bodyBatteryMin          Int?
  bodyBatteryMax          Int?
  bodyBatteryEnd          Int?
  trainingReadinessScore  Int?
  trainingReadinessStatus String?
  dataQuality             String   @default("partial")
  syncedAt                DateTime @default(now())
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([appUserId, sourceProvider, snapshotDate])
  @@index([appUserId, snapshotDate])
  @@index([sourceProvider, snapshotDate])
  @@index([dataQuality])
}

// Donnees fitness quotidiennes provider brutes : VO2max wellness, fitness age,
// acclimatation chaleur/altitude. Distincte de ExternalDailyRecoverySnapshot
// (qui se concentre sur sommeil / VFC / stress / Body Battery).
//
// Source primaire : Garmin Connect via `api.get_max_metrics(date)`
// (endpoint /userstats-service/wellness/<userId>/maxmetrics).
model ExternalDailyFitnessSnapshot {
  id                         String   @id @default(cuid())
  appUserId                  String
  appUser                    AppUser  @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  sourceProvider             String
  snapshotDate               DateTime
  timezone                   String?
  vo2MaxRunning              Float?
  vo2MaxCycling              Float?
  fitnessAge                 Int?
  heatAcclimationPercent     Int?
  altitudeAcclimationPercent Int?
  // Garmin Endurance Score (Firstbeat) : capacite a soutenir un effort long.
  // Echelle Untrained (<3500) -> Superior (>=8500), niveau qualitatif assorti.
  enduranceScore             Int?
  enduranceScoreLevel        String?
  // Garmin Hill Score : fitness specifique aux montees/descentes.
  // Echelle 0-100 + classification (Beginner/Established/Strong/Athlete/Elite).
  hillScore                  Int?
  hillScoreLevel             String?
  dataQuality                String   @default("partial")
  syncedAt                   DateTime @default(now())
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@unique([appUserId, sourceProvider, snapshotDate])
  @@index([appUserId, snapshotDate])
  @@index([sourceProvider, snapshotDate])
}

// Historique consolide du VDOT estime par utilisateur, une valeur par jour.
// Source unique de verite pour l'UI Performance (Vue d'ensemble + Tendances).
//
// Logique de consolidation :
//   1. Si ExternalDailyFitnessSnapshot.vo2MaxRunning existe pour le jour
//      -> source = "garmin", value = vo2MaxRunning
//   2. Sinon si activite enrichie recente (<= 7 j) avec vO2MaxValue non-null
//      -> source = "garmin", value = vO2MaxValue per-activity
//   3. Sinon -> calcul interne Daniels via meilleure perf recente
//      -> source = "estimation_interne"
model VdotHistorySnapshot {
  id                String   @id @default(cuid())
  appUserId         String
  appUser           AppUser  @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  snapshotDate      DateTime
  vdotValue         Float
  source            String
  basedOnActivityId String?
  notes             String?
  createdAt         DateTime @default(now())

  @@unique([appUserId, snapshotDate])
  @@index([appUserId, snapshotDate])
  @@index([source])
}

model ActivityProviderEnrichment {
  id                 String   @id @default(cuid())
  appUserId          String
  appUser            AppUser  @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  activityId         String
  activity           Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  providerCode       String
  providerActivityId String   @default("")
  matchConfidence    Float?
  matchedAt          DateTime?
  status             String   @default("pending")
  normalizedJson     String?
  rawDataId          String?
  lastErrorCode      String?
  lastErrorMessage   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([activityId, providerCode])
  @@index([appUserId, providerCode, status])
  @@index([providerCode, providerActivityId])
}

model ActivityProviderLink {
  id                 String    @id @default(cuid())
  appUserId          String
  appUser            AppUser   @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  activityId         String?
  activity           Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  provider           String
  providerActivityId String
  matchStatus        String
  matchConfidence    Float?
  matchedAt          DateTime?
  rawDataId          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([appUserId, provider, providerActivityId])
  @@index([activityId, provider])
  @@index([appUserId, provider, matchStatus])
}

model ProviderBackfillCursor {
  id                      String    @id @default(cuid())
  appUserId               String
  appUser                 AppUser   @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  windowLogs              ProviderBackfillWindowLog[]
  provider                String
  resourceType            String
  status                  String    @default("idle")
  nextWindowEndDate       DateTime?
  oldestFetchedDate       DateTime?
  windowDays              Int       @default(180)
  lastRunAt               DateTime?
  lastSuccessAt           DateTime?
  lastErrorCode           String?
  lastErrorMessage        String?
  totalWindowsProcessed   Int       @default(0)
  totalActivitiesImported Int       @default(0)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@unique([appUserId, provider, resourceType])
  @@index([provider, resourceType, status])
  @@index([nextWindowEndDate])
}

model ProviderBackfillWindowLog {
  id                        String    @id @default(cuid())
  cursorId                  String
  cursor                    ProviderBackfillCursor @relation(fields: [cursorId], references: [id], onDelete: Cascade)
  appUserId                 String
  appUser                   AppUser   @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  provider                  String
  resourceType              String
  windowStartDate           DateTime
  windowEndDate             DateTime
  status                    String
  fetchedCount              Int       @default(0)
  rawUpsertedCount          Int       @default(0)
  matchedCount              Int       @default(0)
  garminOnlyCreatedCount    Int       @default(0)
  garminOnlyUpdatedCount    Int       @default(0)
  ambiguousCount            Int       @default(0)
  rejectedCount             Int       @default(0)
  duplicateCountAfterWindow Int       @default(0)
  resultJson                String?
  startedAt                 DateTime  @default(now())
  endedAt                   DateTime?
  errorCode                 String?
  errorMessage              String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([cursorId, startedAt])
  @@index([appUserId, provider, resourceType, startedAt])
  @@index([status, startedAt])
}

model SyncJob {
  id                        String   @id @default(cuid())
  appUserId                 String
  appUser                   AppUser  @relation(fields: [appUserId], references: [id])

  jobType                   String   @default("legacy")
  status                    String
  triggerSource             String   @default("ui")
  message                   String?
  errorDetails              String?

  progressPercent           Int?
  pagesProcessed            Int      @default(0)
  activitiesSeen            Int      @default(0)
  activitiesInserted        Int      @default(0)
  activitiesUpdated         Int      @default(0)
  activitiesFailed          Int      @default(0)
  detailsFetched            Int      @default(0)

  lastProcessedActivityDate DateTime?
  lastProcessedActivityId   String?
  requestedAfterEpoch       String?
  resultJson                String?

  queuedAt                  DateTime @default(now())
  startedAt                 DateTime?
  endedAt                   DateTime?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @default(now()) @updatedAt

  @@index([status, queuedAt])
  @@index([jobType, queuedAt])
}

model SyncCursor {
  id          String   @id @default(cuid())
  appUserId   String
  appUser     AppUser  @relation(fields: [appUserId], references: [id])

  cursorName  String
  cursorValue String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([appUserId, cursorName])
}
