DATABASE_URL="postgresql://runsee_app:runsee_dev_password@127.0.0.1:55432/runsee_dev?schema=public"
DIRECT_URL="postgresql://runsee_app:runsee_dev_password@127.0.0.1:55432/runsee_dev?schema=public"
SHADOW_DATABASE_URL="postgresql://runsee_app:runsee_dev_password@127.0.0.1:55432/runsee_shadow?schema=public"

NODE_ENV="development"

# Backend PostgreSQL dev listener
APP_HOST="0.0.0.0"
APP_PORT="3001"

# Frontend PostgreSQL dev server
FRONTEND_PORT="5174"
LOCAL_APP_URL="http://localhost:5174"
LOCAL_API_URL="http://localhost:3001"

# Keep local values for day-to-day development.
PUBLIC_APP_URL="http://localhost:5174"
PUBLIC_API_URL="http://localhost:3001"

# Backward-compatible aliases still supported by the backend config
APP_PUBLIC_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:5174"

FRONTEND_ALLOWED_ORIGINS="http://localhost:5174"

# Use a dedicated Strava dev app for this environment when possible.
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
STRAVA_REDIRECT_URI="http://localhost:3001/auth/strava/callback"
STRAVA_SCOPE="read,profile:read_all,activity:read_all"
RUNSEE_STRAVA_APP_ENCRYPTION_KEY=""
RUNSEE_STRAVA_TOKEN_ENCRYPTION_KEY=""
RUNSEE_PROVIDER_TOKEN_ENCRYPTION_KEY=""
GARMINCONNECT_PYTHON_BIN="python3"
GARMINCONNECT_BRIDGE_TIMEOUT_MS="90000"

STRAVA_INCREMENTAL_FETCH_DETAILS="true"
SYNC_AFTER_OVERLAP_SECONDS="3600"
