{
  "name": "runsee-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "prisma:pg:validate": "prisma validate --config prisma.postgresql.config.ts",
    "prisma:pg:generate": "prisma generate --config prisma.postgresql.config.ts",
    "prisma:pg:migrate:dev": "prisma migrate dev --config prisma.postgresql.config.ts",
    "prisma:pg:migrate:deploy": "prisma migrate deploy --config prisma.postgresql.config.ts",
    "prisma:pg:studio": "prisma studio --config prisma.postgresql.config.ts",
    "pretest": "prisma generate",
    "test": "node --test",
    "db:ensure:postgres": "node scripts/db/ensure-postgresql-databases.js",
    "db:export:sqlite": "node scripts/db/export-sqlite-dump.js",
    "db:import:postgres": "node scripts/db/import-postgresql-dump.js",
    "db:snapshot": "node scripts/db/report-database-snapshot.js",
    "db:compare-schemas": "node scripts/db/compare-prisma-schemas.js",
    "providers:reencrypt": "node scripts/providers/reencrypt-sessions.js"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.6.0",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "axios": "^1.12.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "prisma": "^7.6.0"
  }
}
