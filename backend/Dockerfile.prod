FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
COPY prisma ./prisma
COPY prisma-postgresql ./prisma-postgresql
COPY prisma.postgresql.config.ts ./

RUN npm ci

COPY scripts ./scripts
COPY src ./src

# Prisma 7 reads DATABASE_URL from the config even during generate.
ARG DATABASE_URL="postgresql://runsee_app:placeholder@postgres:5432/runsee_prod?schema=public"
ENV DATABASE_URL=${DATABASE_URL}
RUN npx prisma generate --config prisma.postgresql.config.ts

FROM node:20-alpine AS runtime

WORKDIR /app

COPY requirements-garmin.txt ./requirements-garmin.txt

RUN apk add --no-cache curl tini python3 py3-pip py3-virtualenv \
  && python3 -m venv /opt/runsee-python \
  && /opt/runsee-python/bin/pip install --no-cache-dir --upgrade pip \
  && /opt/runsee-python/bin/pip install --no-cache-dir -r ./requirements-garmin.txt

ENV NODE_ENV=production
ENV GARMINCONNECT_PYTHON_BIN=/opt/runsee-python/bin/python

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/generated ./generated
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/prisma-postgresql ./prisma-postgresql
COPY --from=builder /app/prisma.postgresql.config.ts ./
COPY --from=builder /app/scripts ./scripts
COPY --from=builder /app/src ./src
COPY --from=builder /app/package.json ./

EXPOSE 3003

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["sh", "-c", "npx prisma migrate deploy --config prisma.postgresql.config.ts && node src/server.js"]
