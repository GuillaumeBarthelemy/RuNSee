# Frontend local runtime
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173

# Public URL of the frontend.
# Local only: leave localhost.
# Behind Cloudflare Tunnel: set your public hostname, for example https://runsee.example.com
VITE_APP_BASE_URL=http://localhost:5173

# Public URL of the backend API used by the browser.
# Local only: keep the backend local URL.
# Behind Cloudflare Tunnel: set your public API hostname, for example https://api.example.com
VITE_API_BASE_URL=http://localhost:3000

# Optional explicit local API override.
# Useful when the frontend is opened on localhost while the public tunnel URLs are already configured.
VITE_LOCAL_API_BASE_URL=http://localhost:3000

# Optional password reset entry point.
# Can be an app route or an external auth page.
# Example: https://runsee.example.com/forgot-password
VITE_FORGOT_PASSWORD_URL=
